# Copy to .env and fill in. Never commit .env.

# OpenAI (swap for Azure OpenAI later by changing app/llm/openai_provider.py)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Use "none" for models that reject a custom temperature
OPENAI_TEMPERATURE=0.1

# Azure DevOps (cloud). PAT scopes: Code (Read), Pull Request Threads (Read & write)
ADO_ORG=
ADO_PAT=

# Review limits
MAX_FILES=40
MAX_FILE_CHARS=200000
MAX_CHUNK_CHARS=12000
LLM_CONCURRENCY=4
MIN_CONFIDENCE=0.4
JOB_TTL_SECONDS=3600
