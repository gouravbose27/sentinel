# Copy to .env and fill in. Never commit .env.

# OpenAI (swap for Azure OpenAI later by changing app/llm/openai_provider.py)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Use "none" for models that reject a custom temperature
OPENAI_TEMPERATURE=0.1

# Azure DevOps (cloud). PAT scopes: Code (Read), Pull Request Threads (Read & write),
# and Code (Status) only if STATUS_CHECK_ENABLED=true
ADO_ORG=
ADO_PAT=

# Protect the web UI with HTTP Basic auth (any username, this password). Empty = no protection.
UI_PASSWORD=

# Webhook for automatic reviews. Empty disables POST /webhooks/ado.
# In Azure DevOps add a Service Hook (Pull request created / updated) sending the secret
# as the Basic-auth password or an X-Webhook-Secret header.
WEBHOOK_SECRET=
AUTO_REVIEW_CATEGORIES=bug,test,security,dependency,optimization
AUTO_POST_COMMENTS=true
STATUS_CHECK_ENABLED=false
# Status check fails when a finding is at or above this severity (critical|high|medium|low|info)
BLOCK_ON_SEVERITY=high

# Review limits
MAX_FILES=40
MAX_FILE_CHARS=200000
MAX_CHUNK_CHARS=12000
MAX_SEGMENTS=150
MAX_ACTIVE_JOBS=5
LLM_CONCURRENCY=4
MIN_CONFIDENCE=0.4
JOB_TTL_SECONDS=3600
